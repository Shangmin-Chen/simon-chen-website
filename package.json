{
  "name": "simon-chen-website",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://simon-chen.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shangmin-Chen/simon-chen-website.git"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.3.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "dev:worker": "npm run build && wrangler dev",
    "gallery:resize": "node scripts/resize-gallery.mjs",
    "check:tokens": "node scripts/check-architecture.mjs",
    "lint": "eslint .",
    "verify": "npm run test && npm run build && npm run check:tokens",
    "test": "node --test tests/*.test.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^5.1.2",
    "blurhash": "^2.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "sharp": "^0.35.4",
    "vite": "^7.2.7",
    "wrangler": "^4.54.0"
  },
